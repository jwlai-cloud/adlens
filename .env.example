# Copy to .env.local (gitignored) and fill in from Firebase console > Project settings > Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check debug token you registered in Firebase console > App Check > Manage debug tokens.
# Never commit it. It is baked into your local build only.
VITE_APPCHECK_DEBUG_TOKEN=
