rules_version = '2';
// Shared by AdLens and Memory Lane (same Firebase project). Keep both repos' copies identical.
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared blocklist: anyone can read; signed-in (anonymous) users can add
    // exactly one report at a time, with a fixed shape.
    match /domains/{key} {
      function valid() {
        let d = request.resource.data;
        return key.size() <= 200
          && d.keys().hasOnly(['verdict', 'reasons', 'reports', 'updatedAt'])
          && d.verdict in ['suspicious', 'scam']
          && d.reasons is list && d.reasons.size() <= 3
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create: if request.auth != null && valid() && request.resource.data.reports == 1;
      allow update: if request.auth != null && valid()
        && request.resource.data.reports == resource.data.reports + 1;
      allow delete: if false;
    }

    // "Warn my family" links: readable by anyone with the link, created once with a fixed shape.
    match /shares/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['verdict', 'kind', 'summary', 'reasons', 'actions', 'link', 'createdAt'])
        && request.resource.data.verdict in ['safe', 'suspicious', 'scam']
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 40
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 300
        && request.resource.data.reasons is list && request.resource.data.reasons.size() <= 3
        && request.resource.data.actions is list && request.resource.data.actions.size() <= 3
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Memory Lane family books. The book ID is a long random string shared only by invite link.
    match /books/{bookId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time;

      match /stories/{storyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['title', 'story', 'quote', 'people', 'place', 'year', 'source', 'thumb', 'details', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 120
          && request.resource.data.story is string && request.resource.data.story.size() <= 4000
          && request.resource.data.quote is string && request.resource.data.quote.size() <= 400
          && request.resource.data.people is list && request.resource.data.people.size() <= 6
          && request.resource.data.details is list && request.resource.data.details.size() <= 30
          && request.resource.data.thumb is string && request.resource.data.thumb.size() <= 200000
          && request.resource.data.source in ['on_device', 'in_cloud']
          && request.resource.data.createdAt == request.time;

        // The storyteller's own voice: up to 3 short 8 kHz WAV clips per story.
        match /clips/{clipId} {
          allow read: if request.auth != null;
          allow create: if request.auth != null
            && clipId in ['0', '1', '2']
            && request.resource.data.keys().hasOnly(['text', 'audio', 'seconds', 'createdAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 600
            && request.resource.data.audio is string && request.resource.data.audio.size() <= 700000
            && request.resource.data.audio.matches('^data:audio/wav;base64,.*')
            && request.resource.data.seconds is int && request.resource.data.seconds <= 25
            && request.resource.data.createdAt == request.time;
        }
      }

      match /questions/{qId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['text', 'from', 'createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 200
          && request.resource.data.from is string && request.resource.data.from.size() <= 40
          && request.resource.data.createdAt == request.time;
      }
    }
  }
}
